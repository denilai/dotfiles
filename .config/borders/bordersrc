#!/bin/bash
# JankyBorders: цветная рамка вокруг активного окна (AeroSpace рамок сам не рисует).
# Запускается службой Homebrew: brew services start felixkratz/formulae/borders
# Описание: docs/aerospace.md. Цвет в формате 0xAARRGGBB.
options=(
    style=round
    width=4.8
    hidpi=on
    ax_focus=on                  # фокусное окно по Accessibility: точнее, когда размер окон меняет AeroSpace
    blacklist="VLC"              # окно подгоняет размер под видео, рамка оставалась по старой геометрии
    active_color=0xffff3b30      # красная рамка активного окна (системный красный macOS)
    inactive_color=0x00000000    # у неактивных окон рамки нет
)

borders "${options[@]}"
